# Rendu par l'image nginx (envsubst : seules les variables d'environnement définies sont
# remplacées, les $variables nginx restent intactes).
server_tokens off;

# IP réelle du visiteur : l'en-tête X-Forwarded-For n'est lu que s'il vient de TRUSTED_PROXY_CIDR,
# l'adresse/le réseau du reverse proxy (TLS) TEL QUE VU PAR nginx : 172.16.0.0/12 s'il tourne
# sur la même machine (il arrive par la passerelle Docker), 127.0.0.1 si nginx est exposé
# directement (aucun proxy de confiance).
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Schéma vu par le visiteur : https seulement si c'est le proxy de confiance qui l'annonce
# ($realip_remote_addr = adresse TCP d'origine, avant réécriture par realip).
geo $realip_remote_addr $from_trusted_proxy {
    default 0;
    ${TRUSTED_PROXY_CIDR} 1;
}
map "$from_trusted_proxy:$http_x_forwarded_proto" $fwd_proto {
    default   $scheme;
    "1:https" https;
}

gzip on;
gzip_proxied any;
gzip_types application/json text/css application/javascript;

# Rate limit (F8) : protection brute-force sur les endpoints d'auth, par IP réelle
# (module realip ci-dessus). Le rate-limit applicatif (per-worker) reste une 2e couche.
limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/m;
limit_req_status 429;  # comme le rate-limit applicatif (défaut nginx : 503)

server {
    listen 80;
    server_name _;

    # En-têtes de sécurité (HSTS : à poser sur le reverse proxy qui porte le TLS).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Import d'un RO-Crate (zip pouvant contenir des centaines de PDF) : corps volumineux, sans tampon
    location = /api/v1/projects/import-crate {
        client_max_body_size 1100m;
        proxy_request_buffering off;
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Endpoints d'auth sensibles (identifiants, invitations) : protection brute-force (nginx
    # limit_req, par IP réelle). Pas /auth/me ni /auth/config : appelés à chaque page (429 = déconnexion).
    location ~ ^/api/v1/auth/(login|register|invite|change-password|password-reset/) {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_read_timeout 300s;
    }

    # API backend FastAPI
    location /api/v1/ {
        client_max_body_size 30m;  # dépôt de PDF d'articles
        proxy_buffering off;  # flux SSE du chat RAG (text/event-stream), relayé au fil de l'eau
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;  # jamais l'en-tête fourni par le client
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_read_timeout 300s;
    }

    # Contrat API pour les agents (openapi.json + Swagger UI) : servi par le
    # backend FastAPI, jamais par le frontend (les rewrites Next ne font que le
    # dev ; en conteneur l'origin localhost:8000 n'existe pas).
    location = /openapi.json {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
    }

    # Swagger UI charge ses assets depuis cdn.jsdelivr.net : CSP élargie pour cette page seule.
    # Un add_header dans une location remplace ceux du server : tous re-déclarés.
    location = /docs {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://fastapi.tiangolo.com; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
    }

    # Frontend Next.js
    location / {
        proxy_pass http://frontend:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
    }
}
