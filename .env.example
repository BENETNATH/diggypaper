# =============================================================================
# Diggypaper — variables d'environnement (EXEMPLE)
# =============================================================================
# Copier et adapter. En production, définir des valeurs fortes : le backend
# refuse de démarrer si un secret est encore la valeur de dev (fail-fast).
#
#   Backend  : copier la section BACKEND dans  backend/.env
#   Frontend : définir NEXT_PUBLIC_* dans l'env de build du frontend
#
# Générer un secret :  python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================


# -----------------------------------------------------------------------------
# DEPLOIEMENT (docker compose)
# -----------------------------------------------------------------------------

# nginx est le seul service exposé. Interface d'écoute : 127.0.0.1 (défaut) si le reverse
# proxy TLS est sur la même machine ; 0.0.0.0 s'il est sur une autre machine (filtrer le port).
NGINX_BIND=127.0.0.1
# Port HTTP exposé par nginx.
NGINX_PORT=8080
# Adresse/réseau du reverse proxy TLS, vu depuis nginx (ex. 172.16.0.0/12 si le proxy est sur
# la même machine). Sans cela la limitation de débit par IP ne voit que l'IP du proxy.
TRUSTED_PROXY_CIDR=127.0.0.1

# Tâches de fond en parallèle (imports, analyses, exports) : 2 à 3 minimum.
WORKER_CONCURRENCY=3
# Plafond d'articles par import (max NCBI : 10000).
IMPORT_MAX_ARTICLES=5000
# Durée max d'une tâche, en secondes (0 = aucune limite).
TASK_SOFT_TIME_LIMIT=0
# Plafonds mémoire des conteneurs (défauts ci-dessous).
# OLLAMA_MEM_LIMIT=24g  LAYA_MEM_LIMIT=8g  WORKER_MEM_LIMIT=8g  BACKEND_MEM_LIMIT=2g  FRONTEND_MEM_LIMIT=1g
# Lien vers la politique de confidentialité de l'établissement (affiché au consentement).
PRIVACY_URL=


# -----------------------------------------------------------------------------
# BACKEND (FastAPI + Celery) — backend/.env
# -----------------------------------------------------------------------------

# Base de données (async SQLAlchemy + asyncpg).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/diggypaper

# Secret JWT (HS256) — OBLIGATOIRE en prod, >= 32 octets.
# Ne JAMAIS utiliser la valeur de dev par défaut en production.
JWT_SECRET=dev-secret-change-me-0123456789abcdef

# Durée de vie du token d'accès (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cookie JWT : true (défaut) derrière HTTPS / reverse proxy TLS ; sinon le cookie n'est pas
# envoyé sur HTTP → 401. false uniquement pour un essai en HTTP local (http://localhost).
COOKIE_SECURE=true

# URL publique de l'app, telle que l'ouvrent les utilisateurs (https://… derrière le reverse
# proxy) : base des liens d'invitation dans les e-mails.
APP_BASE_URL=http://localhost:8080

# Sel d'anonymisation RGPD : sha256(anon_salt + email_original).
# Ne JAMAIS utiliser la valeur de dev par défaut en production.
ANON_SALT=diggypaper-anon

# Clé maîtresse AES-256 (Module 7) : chiffre les secrets en base
# (clés API LLM/NCBI/Zotero, mot de passe SMTP).
# 64 caractères hexadécimaux OU 44 caractères base64 (32 octets).
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
# Ne JAMAIS utiliser la valeur de dev par défaut en production.
ENCRYPTION_KEY=dev-encryption-key-change-me-0000000000

# Celery (Module 2 : ingestion PubMed) — broker + result backend Redis.
REDIS_URL=redis://localhost:6379/0
# true = exécution inline sans broker (dev/tests) ; false en production.
CELERY_EAGER=false

# SMTP (FastAPI-Mail). Laisser SMTP_HOST vide pour ne pas envoyer d'emails (dev).
# NB : les valeurs SMTP peuvent aussi être gérées en base (Module 7, priorité DB > env).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# CORS : origines autorisées (JSON array, parsé par pydantic-settings).
# Vide par défaut = pas de CORS (le déploiement est same-origin derrière nginx).
# Ex. : CORS_ORIGINS=["https://app.diggypaper.fr","https://admin.diggypaper.fr"]
CORS_ORIGINS=

# Bootstrap du premier admin (idempotent) : au démarrage, si aucun admin n'existe,
# ce compte est créé (ou l'utilisateur existant est promu). Vide = pas de bootstrap.
# C'est le mécanisme pour démarrer l'app à l'état vide (sinon on ne peut ni inviter ni configurer).
ADMIN_EMAIL=
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# FRONTEND (Next.js) — env de build
# -----------------------------------------------------------------------------

# Origine du backend FastAPI (proxy dev /api/v1 -> <origin>/api/v1).
# En prod, nginx fait le proxy same-origin ; cette variable n'est alors pas lue.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000

# Base des appels API côté client (défaut "/api/v1" = same-origin).
# Laisser vide en prod (le frontend appelle /api/v1, proxifié par nginx).
NEXT_PUBLIC_API_BASE=/api/v1


# -----------------------------------------------------------------------------
# CONFIG GÉRÉE EN BASE (Module 7 — pas des variables d'env)
# -----------------------------------------------------------------------------
# Ces réglages se configurent via l'API settings (PUT /api/v1/admin/settings)
# ou l'UI Paramètres, et sont chiffrés (AES-256-GCM) en base :
#   llm_api_base_url  (défaut http://localhost:11434/v1 — Ollama / llama.cpp)
#   llm_api_key       (secret, chiffré)
#   ncbi_api_key      (secret, chiffré — 10 req/s au lieu de 3 sans clé)
#   zotero_group_id / zotero_api_key
#   smtp_host / smtp_port / smtp_user / smtp_password / smtp_from_email / use_tls
# => Aucune variable d'env n'est requise pour le LLM / NCBI / Zotero.

# --- Modèles ---
# Services de modèles LOCAUX, tous optionnels (profils du compose) : n'activez que ce qu'il vous
# faut. Avec un modèle externe (API compatible OpenAI, saisie dans la page Modèles), aucun
# n'est nécessaire.
#   ollama : modèles génératifs locaux (réponses en texte libre, citations)
#   laya   : modèle de décision Laya (CPU, très rapide, oui/non + choix)
#   kev    : modèle de décision Kev (llama.cpp, ~3 Go)
# COMPOSE_PROFILES=ollama,laya
# LLM_API_BASE_URL=http://ollama:11434/v1   # avec le profil ollama
# LAYA_URL=http://laya:8000                 # avec le profil laya (modèles Laya enregistrés au démarrage)
# KEV_URL=http://kev:8080                   # avec le profil kev (modèle Kev-4B enregistré au démarrage)

# Langue par défaut de l'interface, des e-mails et des nouveaux comptes : fr, en, de ou es.
DEFAULT_LANGUAGE=fr
