# =============================================================================
# Diggypaper — environment variables (EXAMPLE)
# =============================================================================
# Copy and adapt. In production, set strong values: the backend
# refuses to start if a secret is still the dev value (fail-fast).
#
#   Backend  : copy the BACKEND section into  backend/.env
#   Frontend : set NEXT_PUBLIC_* in the frontend build env
#
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================


# -----------------------------------------------------------------------------
# DEPLOYMENT (docker compose)
# -----------------------------------------------------------------------------

# nginx is the only exposed service. Listen interface: 127.0.0.1 (default) if the TLS
# reverse proxy is on the same machine; 0.0.0.0 if it is on another machine (filter the port).
NGINX_BIND=127.0.0.1
# HTTP port exposed by nginx.
NGINX_PORT=8080
# Address/network of the TLS reverse proxy, as seen from nginx (e.g. 172.16.0.0/12 if the proxy
# is on the same machine). Without this, IP rate limiting only sees the proxy's IP.
TRUSTED_PROXY_CIDR=127.0.0.1

# Background tasks in parallel (analyses, exports, benchmarks): minimum 2 to 3.
# NCBI imports run on a dedicated worker (worker-ingest, 1 process, "ingest" queue):
# the NCBI throttle (3 req/s without a key, 10 with) is per process.
WORKER_CONCURRENCY=3
# Cap on articles per import; 0 = unlimited (queries of more than 10,000 results are
# split by publication date, most recent first).
IMPORT_MAX_ARTICLES=5000
# Maximum duration of a task, in seconds (0 = no limit).
TASK_SOFT_TIME_LIMIT=0
# Memory ceilings for the containers (defaults below).
# OLLAMA_MEM_LIMIT=24g  WORKER_MEM_LIMIT=8g  INGEST_MEM_LIMIT=2g  BACKEND_MEM_LIMIT=2g  FRONTEND_MEM_LIMIT=1g
# Disk space: e-mail to admins (and banner) above this usage rate or below this free space.
# DISK_ALERT_PERCENT=85
# DISK_ALERT_FREE_GB=5
# Inactive projects: after N days without activity, the leads are notified by e-mail; without
# activity (nor "Keep this project") during the grace period, the project is deleted. 0 = never.
# PROJECT_RETENTION_DAYS=0
# PROJECT_RETENTION_GRACE_DAYS=14
# License of the RO-Crate export metadata and results (PDFs and full texts: their publishers' license).
# CRATE_LICENSE_URL=https://creativecommons.org/licenses/by/4.0/
# CRATE_LICENSE_NAME=CC BY 4.0
# Link to the institution's privacy policy (shown at the consent screen).
PRIVACY_URL=


# -----------------------------------------------------------------------------
# BACKEND (FastAPI + Celery) — backend/.env
# -----------------------------------------------------------------------------

# Database (async SQLAlchemy + asyncpg).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/diggypaper

# JWT secret (HS256) — REQUIRED in production, >= 32 bytes.
# NEVER use the default dev value in production.
JWT_SECRET=dev-secret-change-me-0123456789abcdef

# Access token lifetime (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# JWT cookie: true (default) behind HTTPS / TLS reverse proxy; otherwise the cookie is not
# sent over HTTP -> 401. false only for a local HTTP trial (http://localhost).
COOKIE_SECURE=true

# Public URL of the app, as opened by users (https://... behind the reverse
# proxy): base of the invitation links in e-mails.
APP_BASE_URL=http://localhost:8080

# GDPR anonymization salt: sha256(anon_salt + original_email).
# NEVER use the default dev value in production.
ANON_SALT=diggypaper-anon

# AES-256 master key (Module 7): encrypts secrets in the database
# (LLM/NCBI API keys, SMTP password).
# 64 hex characters OR 44 base64 characters (32 bytes).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the default dev value in production.
ENCRYPTION_KEY=dev-encryption-key-change-me-0000000000

# Celery (Module 2: PubMed ingestion) — Redis broker + result backend.
REDIS_URL=redis://localhost:6379/0
# true = inline execution without broker (dev/tests); false in production.
CELERY_EAGER=false

# SMTP (FastAPI-Mail). Leave SMTP_HOST empty to not send e-mails (dev).
# NB: the SMTP values can also be managed in the database (Module 7, DB > env priority).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# CORS: allowed origins (JSON array, parsed by pydantic-settings).
# Empty by default = no CORS (the deployment is same-origin behind nginx).
# E.g.: CORS_ORIGINS=["https://app.diggypaper.fr","https://admin.diggypaper.fr"]
CORS_ORIGINS=

# Bootstrap of the first admin (idempotent): at startup, if no admin exists,
# this account is created (or the existing user is promoted). Empty = no bootstrap.
# This is the mechanism to start the app in an empty state (otherwise you can neither invite nor configure).
ADMIN_EMAIL=
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# FRONTEND (Next.js) — build env
# -----------------------------------------------------------------------------

# Origin of the FastAPI backend (dev proxy /api/v1 -> <origin>/api/v1).
# In production, nginx proxies same-origin; this variable is not read then.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000

# Base of the client-side API calls (default "/api/v1" = same-origin).
# Leave empty in production (the frontend calls /api/v1, proxied by nginx).
NEXT_PUBLIC_API_BASE=/api/v1


# -----------------------------------------------------------------------------
# DB-MANAGED SETTINGS (Module 7 — not env variables)
# -----------------------------------------------------------------------------
# These settings are configured via the settings API (PUT /api/v1/admin/settings)
# or the Settings UI, and are encrypted (AES-256-GCM) in the database:
#   llm_api_base_url  (default http://localhost:11434/v1 — Ollama / llama.cpp)
#   llm_api_key       (secret, encrypted)
#   ncbi_api_key      (secret, encrypted — 10 req/s instead of 3 without a key)
#   smtp_host / smtp_port / smtp_user / smtp_password / smtp_from_email / use_tls
# => No env variable is required for the LLM / NCBI.

# --- Models ---
# Ranking is done with a generative model: either external (OpenAI-compatible API, entered in the
# Models page, no local install) or local with Ollama (optional compose profile).
# The Models page recommends models suited to the server resources (RAM, CPU, GPU).
# The Ollama mode is driven by the OLLAMA_MODE pair (flag read by backend/worker) /
# COMPOSE_PROFILES (compose container):
# OLLAMA_MODE=docker   # docker = compose Ollama container (COMPOSE_PROFILES=ollama) — default;
#                      # host = Ollama already deployed on the machine (no profile, LLM_API_BASE_URL
#                      # = host URL); off = no Ollama (no profile, API-key backends only)
# COMPOSE_PROFILES=ollama
# LLM_API_BASE_URL=http://ollama:11434/v1   # compose default; change for another server
# (e.g. http://host.docker.internal:11434/v1 for the host machine's Ollama in host mode)

# Default language of the interface, e-mails and new accounts: fr, en, de or es.
DEFAULT_LANGUAGE=fr
